# FinPilot AI Environment Configuration Example
# Copy to .env in backend/ or root for local development

# ==========================================
# APPLICATION SETTINGS
# ==========================================
ENVIRONMENT=development
DEBUG=True
APP_NAME="FinPilot AI"
API_V1_STR="/api/v1"
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==========================================
# CORS CONFIGURATION (Frontend Origins)
# ==========================================
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ==========================================
# DATABASE SETTINGS
# ==========================================
# For SQLite (default zero-setup local development):
DATABASE_URL="sqlite:///./finpilot.db"

# For PostgreSQL / Neon (Production):
# DATABASE_URL="postgresql+asyncpg://user:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/finpilot?sslmode=require"
# DATABASE_SYNC_URL="postgresql://user:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/finpilot?sslmode=require"

# ==========================================
# REDIS / CACHING SETTINGS
# ==========================================
REDIS_ENABLED=False
REDIS_URL="redis://localhost:6379/0"

# ==========================================
# AI / LLM PROVIDERS
# ==========================================
# Supported: gemini, openai, fallback
DEFAULT_LLM_PROVIDER="fallback"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
AI_MAX_TOKENS_PER_USER_DAY=50000

# ==========================================
# MARKET DATA PROVIDERS
# ==========================================
# Supported: mock, twelvedata, alphavantage, finnhub
PRIMARY_MARKET_DATA_PROVIDER="mock"
TWELVE_DATA_API_KEY=""
ALPHA_VANTAGE_API_KEY=""
FINNHUB_API_KEY=""

# ==========================================
# BROKER ARCHITECTURE SAFETY GATES
# ==========================================
ENABLE_MOCK_BROKERS=True
ENABLE_LIVE_BROKER_EXECUTION=False
BROKER_SIMULATION_MODE=True

# ==========================================
# SEED & ADMIN CREDENTIALS
# ==========================================
ADMIN_EMAIL="admin@finpilot.ai"
ADMIN_PASSWORD="AdminSecurePassword123!"
DEMO_USER_EMAIL="trader@finpilot.ai"
DEMO_USER_PASSWORD="TraderPassword123!"
